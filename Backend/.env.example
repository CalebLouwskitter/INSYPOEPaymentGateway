# MongoDB Configuration
# Authenticated connection with least-privilege user and TLS:
MONGODB_URI=mongodb://insy7314_app:your_secure_app_password_change_this@localhost:27017/insy7314?authSource=insy7314&tls=true&tlsCAFile=../certs/mongo/ca.pem
MONGODB_TLS_CA_FILE=../certs/mongo/ca.pem
# For unauthenticated local development only:
# MONGODB_URI=mongodb://localhost:27017/insy7314

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=5000
NODE_ENV=development
USE_HTTPS=false
# For local development, do not force HTTPS to avoid 426/400 responses when using http
FORCE_HTTPS=false

# Reverse proxy: leave unset when the API is reached directly. Behind one Nginx/load balancer
# set TRUST_PROXY=1 so client IPs (rate limiting) and HTTPS detection come from X-Forwarded-*.
# TRUST_PROXY=1

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# CORS Configuration (comma-separated list for multiple origins)
CORS_ORIGINS=http://localhost:3000,https://localhost:3000
